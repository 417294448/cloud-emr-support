{
  "dataAsOf": "2026-09-01",
  "standardSupportPolicy": {
    "source": "https://help.aliyun.com/zh/emr/emr-on-ecs/product-overview/lifecycle-policies-for-emr-on-ecs",
    "note": {
      "en": "Alibaba Cloud EMR on ECS manages each release through a three-stage lifecycle: GA, EOM, and EOS.",
      "zh": "阿里云 EMR on ECS 通过 GA、EOM、EOS 三个阶段管理每个发行版本的生命周期。"
    },
    "milestones": {
      "GA": {
        "en": "General Availability — the release is published and available for production use, with technical support and SLA coverage.",
        "zh": "General Availability（正式发布）— 该版本已发布，可用于生产环境，并提供技术支持与 SLA 保障。"
      },
      "EOM": {
        "en": "End of Market — nominally GA date + 3 years. New clusters can no longer be created on this release; existing clusters keep receiving technical support and SLA coverage.",
        "zh": "End of Market（停止销售）— 名义上为 GA 日期 + 3 年。此后无法基于该版本新建集群，存量集群仍继续获得技术支持与 SLA 保障。"
      },
      "EOS": {
        "en": "End of Service & Support — at least EOM date + 1 year. All technical support and SLA guarantees stop; migrate off this release before this date.",
        "zh": "End of Service & Support（停止服务与支持）— 至少为 EOM 日期 + 1 年。所有技术支持与 SLA 保障终止，请在此日期前迁移离开该版本。"
      }
    }
  },
