# build-emr-console skill: index-new.html is renamed to index.html on every
# successful run and shouldn't normally exist on disk; index-old.html is the
# one-generation local rollback backup left behind by that promotion — git
# history is the real backup, so neither is meant to be committed.
index-new.html
index-old.html

# superpowers brainstorming session artifacts
.superpowers/

# scratch scripts used during one-off data extraction (see build-emr-console SKILL.md)
.tmp_*

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# editor/IDE
.vscode/
.idea/
*.swp

# node (no package.json yet, but scripts/*.js may grow dependencies later)
node_modules/
npm-debug.log*
